{
  "phases": [
    {
      "id": "phase_preflight",
      "title": "Подготовка к вылету",
      "time": "40 мин до TOBT",
      "procedures": [
        {
          "id": "proc_electrical_up",
          "title": "Electrical Power Up",
          "pdfRef": { "label": "РПП А", "file": "modules/flightprocedures/AOMA.pdf", "page": 128 },
          "content": [
            { "type": "condition", "text": "The First Officer normally does this procedure." },
            { "type": "action", "label": "BATTERY switch", "value": "Guard closed" },
            { "type": "tail", "text": "VP-BDP – VQ-BDC, VQ-BVY" },
            { "type": "note", "text": "Do not move the airplane until ISFD alignment is complete." },
            { "type": "action", "label": "STANDBY POWER switch", "value": "Guard closed" },
            { "type": "action", "label": "ALTERNATE FLAPS master switch", "value": "Guard closed" },
            { "type": "separator" },
            { "type": "condition", "text": "If APU power is needed:" },
            { "type": "action", "label": "TEST switch", "value": "Hold to FAULT/INOP" },
            { "type": "verify", "text": "Verify that the MASTER CAUTION / OVHT/DET / FAULT lights are illuminated." },
            { "type": "caution", "text": "Center tank fuel pump switches should be positioned ON only if the fuel quantity in the center tank exceeds 453 kgs / 1000 lbs." }
          ]
        },
        {
          "id": "proc_preliminary_preflight",
          "title": "Preliminary Preflight",
          "content": [
            { "type": "action-crew", "label": "VOICE RECORDER switch", "value": "On", "crew": "C" },
            { "type": "action-crew", "label": "VOICE RECORDER Test switch", "value": "Push", "crew": "F" },
            { "type": "verify", "text": "Hold switch for 5 seconds." },
            { "type": "separator" },
            { "type": "action", "label": "Oxygen pressure", "value": "Check" },
            { "type": "image", "src": "modules/flightprocedures/oxy_chart.jpg", "fullSrc": "modules/flightprocedures/oxy_chart_full.jpg" },
            { "type": "action", "label": "Hydraulic quantity", "value": "min 76% / after Daily Check 92%" },
            { "type": "action", "label": "Engine oil quantity", "value": "min 60% / 12 US qt" }
          ]
        }
      ]
    },
    {
      "id": "phase_exterior",
      "title": "Внешний осмотр",
      "procedures": [
        {
          "id": "proc_exterior_inspection",
          "title": "Exterior Inspection",
          "pdfRef": { "label": "РПП А", "file": "modules/flightprocedures/AOMA.pdf", "page": 55 },
          "content": [
            { "type": "condition", "text": "Before each flight the Captain and maintenance crew must verify that the airplane is satisfactory for flight." },
            { "type": "image", "src": "modules/flightprocedures/ext_walk.jpg", "fullSrc": "modules/flightprocedures/ext_walk_full.jpg" },
            { "type": "action", "label": "Left Forward Fuselage — Probes, ports, vents", "value": "Check" },
            { "type": "verify", "text": "Probes, vents, and static ports are clear and not damaged." },
            { "type": "action", "label": "Doors and access panels", "value": "Latched" },
            { "type": "caution", "text": "Thin hoarfrost is acceptable on the upper fuselage surface provided all vents and ports are clear." }
          ]
        }
      ]
    }
  ]
}